{
  "name": "matrical",
  "private": true,
  "version": "1.0.0",
  "description": "MATRICAL - Calculatrice & Solveur Matriciel",
  "author": "MATRICAL",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('release', { recursive: true, force: true })\"",
    "build": "npm run clean && node scripts/generate_ico.js && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "dist": "npm run build && npx electron-builder --win",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.matrical.app",
    "productName": "MATRICAL",
    "electronVersion": "30.5.1",
    "icon": "icon.ico",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "icon.ico",
      "package.json",
      "cli.py",
      "core/**/*",
      "utils/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "icon.ico"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "to-ico": "^1.1.5",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
